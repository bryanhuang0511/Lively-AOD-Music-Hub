{
  "manifest_version": 3,
  "name": "Lively AOD Music Hub - Zero-Server Fast-Forward Sync",
  "version": "1.4.1",
  "description": "Zero-Width GSMTC Steganography Tunnel: instantly syncs YouTube Music & YouTube fast-forward/seek timestamps natively into Lively Wallpaper.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Lively AOD Fast-Forward Sync (Active)",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [],
  "content_scripts": [
    {
      "matches": [
        "*://music.youtube.com/*",
        "*://www.youtube.com/*",
        "*://open.spotify.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
